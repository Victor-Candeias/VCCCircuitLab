# ============================================
# CircuitForge - .gitignore
# React + Vite + TypeScript + Python + FastAPI
# ============================================

# --- Node.js / React / Vite ---
node_modules/
dist/
build/
.vite/
.cache/
coverage/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Python ---
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg
*.egg-info/
.eggs/
build/
dist/
pip-wheel-metadata/

# --- Python Virtual Environments ---
.venv/
venv/
env/
ENV/
virtualenv/

# --- Python Testing / Linting ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
coverage.xml

# --- Python Packaging ---
.pyre/
.pytype/
pip-log.txt
pip-delete-this-directory.txt

# --- Environment Variables / Secrets ---
.env
.env.*
!.env.example
!.env.*.example
*.local
!.gitignore

# --- IDEs / Editors ---
.vs/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.user
*.userosscache
*.sln.docstates

# --- Operating Systems ---
.DS_Store
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
*.swp
*.swo
*~

# --- Logs ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# --- Scripts start.sh/stop.sh (PIDs e logs) ---
.run/

# --- Temporary Files ---
tmp/
temp/
*.tmp
*.temp
*.bak
*.backup
*.orig

# --- Databases ---
*.db
*.sqlite
*.sqlite3
*.db-journal

# --- CircuitForge Generated Files ---
# Circuit simulations
simulation-results/
simulation-cache/
backend/generated/
backend/output/

# --- Exported Circuit Files ---
exports/
*.raw
*.netlist.tmp

# --- SPICE / ngspice ---
*.raw
*.tr0
*.ac0
*.sw0
*.op.raw

# --- Docker ---
docker-compose.override.yml

# --- Local Certificates ---
*.pem
*.key
*.p12
*.pfx
