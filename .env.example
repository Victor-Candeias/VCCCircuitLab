# Copiar para `.env` (ignorado pelo git) e preencher. Nunca fazer commit de segredos.

# MongoDB
MONGODB_HOST=127.0.0.1
MONGODB_PORT=27017
MONGODB_DATABASE=VCCCircuitLab
MONGODB_USERNAME=
MONGODB_PASSWORD=
MONGODB_AUTH_SOURCE=VCCCircuitLab

# Chave de encriptação dos dados dos utilizadores (Fernet). Gerar com:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Sem esta chave os dados encriptados não se recuperam.
DATA_ENCRYPTION_KEY=
