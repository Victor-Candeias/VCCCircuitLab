# Copiar para `.env` (ignorado pelo git) e preencher. Nunca fazer commit de segredos.

# MongoDB
MONGODB_HOST=127.0.0.1
MONGODB_PORT=27017
MONGODB_DATABASE=VCCCircuitLab
MONGODB_USERNAME=
MONGODB_PASSWORD=
MONGODB_AUTH_SOURCE=VCCCircuitLab

# Chave de encriptação dos dados dos utilizadores (Fernet). Gerar com:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Sem esta chave os dados encriptados não se recuperam.
DATA_ENCRYPTION_KEY=

# Duração das sessões de login, em horas (opcional; por omissão 8).
# SESSION_TTL_HOURS=8

# Administrador (role ADMIN), criado/reposto com `python -m app.users.seed_admin` (em apps/api).
# ADMIN_NAME é opcional (por omissão "Administrador").
ADMIN_EMAIL=
ADMIN_PASSWORD=
# ADMIN_NAME=Administrador

# Segurança operacional da API (E5-04; ver apps/api/README.md). 0 desativa o limite.
# Origens do frontend autorizadas por CORS, separadas por vírgulas (vazio = só mesma origem).
# CORS_ALLOWED_ORIGINS=https://utilizador.github.io
# MAX_REQUEST_BODY_BYTES=1048576
# RATE_LIMIT_PER_MINUTE=120
# AUTH_RATE_LIMIT_PER_MINUTE=20
# SIMULATION_TIMEOUT_S=5

# Motor de simulação (F2-01; ver apps/api/README.md): `mna` (interno, por omissão) ou `ngspice`.
# Com Docker, construir a imagem com WITH_NGSPICE=true para incluir o ngspice.
# SIMULATION_ENGINE=mna
# WITH_NGSPICE=false
# Executável do ngspice (vazio = procurar `ngspice` no PATH) e limite de memória por simulação.
# NGSPICE_PATH=
# NGSPICE_MAX_MEMORY_MB=512

# Observabilidade (E5-05; ver apps/api/README.md). Nível dos logs `app.*`.
# LOG_LEVEL=INFO
# Token para GET /metrics (Authorization: Bearer …). Vazio = endpoint desativado. Gerar com:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# METRICS_TOKEN=
